## Make /etc/hosts nicer to read, see `man hosts 5` to see the format
syntax "/etc/hosts" "^/etc/hosts$" "^\/etc\/hosts\.d\/.*\.hosts$"

color bold,azure "^[[:space:]]*[.0-9A-Z_]*.*$"

# IPv4
color bold,volt "^[0-9\.]+\s"

# IPv6
icolor bold,piggy "^[0-9a-f:]+\s"

# interpunction
color carrot "[.:]"

# comments
color italic,voodoo "^#.*"
